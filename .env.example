# ── Second Brain · Environment Config ────────────────────────
# Copy this to .env and fill in your values.
# Never commit .env to git.

# ═══════════════════════════════════════════════════════════════
# PHASE 1 — Ingestion Pipeline
# ═══════════════════════════════════════════════════════════════

# Redis (task queue)
REDIS_URL=redis://localhost:6379/0

# Storage: where uploaded/captured files land on disk
STORAGE_PATH=./storage/uploads

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# Tesseract binary path (override if not on PATH)
# TESSERACT_CMD=/usr/bin/tesseract

# Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL=base

# Watcher: folder the daemon monitors for new screenshots/files
WATCH_FOLDER=./watched_inbox

# ═══════════════════════════════════════════════════════════════
# PHASE 2 — Intelligence Pipeline
# ═══════════════════════════════════════════════════════════════

# LLM API Keys (at least one required for summarisation + entity extraction)
OPENAI_API_KEY=sk-...your-key-here...
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Neo4j (graph database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secondbrain

# Qdrant (vector store)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=second_brain_items

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Summariser LLM
# Provider: openai | anthropic
SUMMARISER_PROVIDER=openai
# Model: gpt-4o-mini (openai) or claude-sonnet-4-20250514 (anthropic)
SUMMARISER_MODEL=gpt-4o-mini
